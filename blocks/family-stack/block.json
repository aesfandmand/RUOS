    "note": {
      "type": "text",
      "required": false
    },
    "families": {
      "type": "list",
      "required": true,
      "min": 2,
      "max": 5,
      "item": {
        "kicker": "text",
        "title": "text",
        "body": "text",
        "tags": "list"
      }
    }
  },
  "adjacency": {
    "not_after_same_family": true
  },
  "source": {
    "page": "builds/structures-final/index.html",
    "selector": ".sp-family-stack"
  }
}
