{
  "id": "family-stack",
  "name": {
    "fa": "پشتهٔ خانواده‌ها",
    "en": "Full-bleed family stack"
  },
  "role": "content",
  "family": "catalog",
  "surface": "dark",
  "composition": "stacked full-height cards, each with number, copy and art panel",
  "serves_intent": [
    "compare",
    "browse"
  ],
  "position": "any",
  "behavior": false,
  "slots": {
