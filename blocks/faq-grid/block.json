{
  "id": "faq-grid",
  "name": {
    "fa": "شبکهٔ پرسش‌ها",
    "en": "FAQ grid"
  },
  "role": "content",
  "family": "qa",
  "surface": "light",
  "composition": "two-column disclosure grid",
  "serves_intent": [
    "remove-objection",
    "answer"
  ],
  "position": "any",
  "behavior": false,
  "slots": {
    "eyebrow": {
      "type": "text",
      "required": false
    },
    "title": {
      "type": "text",
      "required": true
    },
    "questions": {
      "type": "list",
      "required": true,
      "min": 3,
      "max": 10,
      "item": {
        "q": "text",
        "a": "text"
      }
    }
  },
  "adjacency": {
    "not_after_same_family": true
  },
  "source": {
    "page": "builds/structures-final/index.html",
    "selector": ".sp-faq"
  }
}
