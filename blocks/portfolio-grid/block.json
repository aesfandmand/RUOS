  "role": "content",
  "family": "catalog",
  "surface": "paper",
  "composition": "Every sample as a plated card — project or industry, city, year and our role — filterable first by service family and then by final service, the level the visitor actually searches at. The filter states that it is a filter, rewrites the address so the view can be sent on, and reports how many samples it is showing. A wide cell opens every group of five on one six-column field, so the grid never reads as identical boxes (§23). Card anatomy from reference/card-anatomy-references/04 and /11, chips-above-the-grid from /08; on a phone the rhythm survives as one full-width card and two half-width ones (§14).",
  "serves_intent": [
    "browse",
    "compare",
    "verify"
  ],
  "position": "any",
  "behavior": true,
  "adjacency": {
    "not_after_same_family": true
  },
  "motion": "skeleton-to-content",
  "source": {
    "page": "reference/card-anatomy-references/README.md",
    "selector": "04-two-card-variants-overlay-vs-body + 08 chips above the grid"
  },
