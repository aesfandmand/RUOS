{
  "id": "index-strip",
  "name": {
    "fa": "نوار فهرست فصل‌ها",
    "en": "Chapter index strip"
  },
  "role": "content",
  "family": "navigation",
  "surface": "light",
  "composition": "numbered in-page navigation cells",
  "serves_intent": [
    "orient",
    "navigate"
  ],
  "position": "any",
  "behavior": false,
  "slots": {
    "entries": {
      "type": "list",
      "required": true,
      "min": 3,
      "max": 6,
      "item": {
        "label": "text",
        "href": "text"
      }
    }
  },
  "adjacency": {
    "not_after_same_family": true
  },
  "source": {
    "page": "builds/structures-final/index.html",
    "selector": ".sp-index"
  }
}
