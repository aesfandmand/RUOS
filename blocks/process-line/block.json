{
  "id": "process-line",
  "name": {
    "fa": "نوار فرایند",
    "en": "Process line"
  },
  "role": "content",
  "family": "process",
  "surface": "paper",
  "composition": "equal-weight numbered process steps in one band",
  "serves_intent": [
    "de-risk",
    "explain"
  ],
  "position": "any",
  "behavior": false,
  "slots": {
    "eyebrow": {
      "type": "text",
      "required": false
    },
    "title": {
      "type": "text",
      "required": true
    },
    "note": {
      "type": "text",
      "required": false
    },
    "steps": {
      "type": "list",
      "required": true,
      "min": 3,
      "max": 6,
      "item": {
        "title": "text",
        "body": "text"
      }
    }
  },
  "adjacency": {
    "not_after_same_family": true
  },
  "source": {
    "page": "builds/structures-final/index.html",
    "selector": ".sp-process-line"
  }
}
