{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUOS Content Intelligence Research Evidence",
  "type": "object",
  "required": ["project_id", "source", "source_class", "observed_at", "topic", "confidence"],
  "properties": {
    "project_id": {"type": "string"},
    "source": {"type": "string"},
    "source_class": {"enum": ["owned", "competitive", "search", "community", "first_party"]},
    "canonical_url": {"type": ["string", "null"]},
    "source_identifier": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "topic": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "language": {"type": ["string", "null"]},
    "geography": {"type": ["string", "null"]},
    "query": {"type": ["string", "null"]},
    "intent": {"type": ["string", "null"]},
    "funnel_stage": {"type": ["string", "null"]},
    "pain": {"type": ["string", "null"]},
    "question": {"type": ["string", "null"]},
    "objection": {"type": ["string", "null"]},
    "hook": {"type": ["string", "null"]},
    "format": {"type": ["string", "null"]},
    "angle": {"type": ["string", "null"]},
    "visible_metrics": {"type": "object", "additionalProperties": {"type": ["number", "integer", "null"]}},
    "outlier_ratio": {"type": ["number", "null"], "minimum": 0},
    "evidence_summary": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "commercial_relevance": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "corroboration_status": {"enum": ["single_source", "corroborated", "first_party_confirmed", "hypothesis_only", "locally_corroborated"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
